PORT=3000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/community-waste-collection
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Optional Twilio SMS configuration. Leave blank to run without SMS delivery.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Used by `npm run seed:admin` to create the first admin account.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_PHONE=+15551234567
